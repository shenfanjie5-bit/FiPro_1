{
  "version": "0.1.1",
  "event_schema": {
    "required_fields": [
      "event_type",
      "direction",
      "severity",
      "source_quality",
      "model_confidence",
      "half_life_days",
      "evidence_refs"
    ],
    "event_type_enum": [
      "policy",
      "earnings",
      "supply_chain",
      "governance",
      "macro",
      "other"
    ]
  },
  "event_value_formula": "direction * severity * source_quality * model_confidence * exp(-age_days / half_life_days)",
  "mappings": [
    {
      "event_type": "policy",
      "target_factor": "event.policy_signal",
      "aggregation": "ema",
      "half_life_days": 5
    },
    {
      "event_type": "macro",
      "target_factor": "event.policy_signal",
      "aggregation": "ema",
      "half_life_days": 4
    },
    {
      "event_type": "governance",
      "target_factor": "event.governance_signal",
      "aggregation": "ema",
      "half_life_days": 7
    }
  ],
  "llm_contract": {
    "response_format": {
      "type": "json_object"
    },
    "must_not_output": [
      "final_action",
      "target_position",
      "order_quantity"
    ],
    "notes": "LLM only outputs structured events. Final actions are generated by deterministic policy engine."
  }
}
