{
  "version": "0.1.2",
  "score_formula": {
    "type": "tanh_linear",
    "description": "z = b + sum(weight_i * factor_i), then map to [0, 100].",
    "intercept": 0.0,
    "weighted_sum_source": "factors.weighted_sum",
    "base_transform": {
      "center": 50.0,
      "scale": 50.0,
      "function": "tanh"
    },
    "risk_penalty_source": "risk.total_penalty",
    "data_quality_penalty_source": "data_quality.penalty",
    "regime_bonus_source": "regime.bonus",
    "clamp": [
      0,
      100
    ]
  },
  "confidence_formula": {
    "type": "linear",
    "description": "confidence = clamp(c0 + c1*dq + c2*coverage - c3*conflict - c4*staleness, 0, 1)",
    "coefficients": {
      "c0": 0.25,
      "c1_data_quality_score": 0.35,
      "c2_evidence_coverage": 0.3,
      "c3_factor_conflict": 0.2,
      "c4_staleness": 0.15
    },
    "clamp": [
      0,
      1
    ]
  }
}
