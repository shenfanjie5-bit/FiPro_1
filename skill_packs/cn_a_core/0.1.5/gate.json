{
  "version": "0.1.5",
  "required_metrics": [
    "strategy_total_return_pct",
    "excess_return_pct",
    "max_drawdown",
    "volatility",
    "turnover",
    "win_rate",
    "cost_budget_violation_rate",
    "data_quality_degraded_rate"
  ],
  "promotion_rule": {
    "from_status": "candidate",
    "to_status": "champion",
    "all_of": [
      {
        "metric": "excess_return_delta_pct",
        "op": ">=",
        "value": 1.0
      },
      {
        "metric": "max_drawdown_delta_pct",
        "op": "<=",
        "value": 2.0
      },
      {
        "metric": "turnover_delta_pct",
        "op": "<=",
        "value": 20.0
      },
      {
        "metric": "data_quality_degraded_rate_delta_pct",
        "op": "<=",
        "value": 0.0
      },
      {
        "metric": "segment_win_rate",
        "op": ">=",
        "value": 0.7
      }
    ]
  },
  "segment_window_points": 20,
  "anti_overfit": {
    "require_train_validation_split": true,
    "require_threshold_sensitivity_check": true,
    "max_param_changes_per_iteration": 8,
    "require_walk_forward_check": true,
    "walk_forward_window_points": 20,
    "walk_forward_min_pass_rate": 0.7,
    "require_bootstrap_significance_check": true,
    "bootstrap_samples": 500,
    "bootstrap_seed": 7,
    "bootstrap_min_confidence": 0.7
  },
  "manual_approval_required": true
}
