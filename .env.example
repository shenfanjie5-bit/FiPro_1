APP_ENV=dev
APP_PORT=8000
APP_DEFAULT_RUN_MODE=LIVE

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/fipro1
REDIS_URL=redis://localhost:6379/0
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j

LLM_PROFILES=mock,openclaw
LLM_PROFILE_ID=mock

LLM_PROFILE_MOCK_LABEL=mock
LLM_PROFILE_MOCK_PROVIDER=mock
LLM_PROFILE_MOCK_BASE_URL=https://api.openai.com/v1
LLM_PROFILE_MOCK_API_KEY=
LLM_PROFILE_MOCK_PRIMARY_MODEL=mock-primary-v1
LLM_PROFILE_MOCK_REVIEWER_MODEL=NONE
LLM_PROFILE_MOCK_SHADOW_MODEL=mock-challenger-v1
LLM_PROFILE_MOCK_SHADOW_REVIEWER_MODEL=NONE

LLM_PROFILE_OPENCLAW_LABEL=openclaw
LLM_PROFILE_OPENCLAW_PROVIDER=openai_compatible
LLM_PROFILE_OPENCLAW_BASE_URL=http://127.0.0.1:18789/v1
LLM_PROFILE_OPENCLAW_API_KEY=
LLM_PROFILE_OPENCLAW_PRIMARY_MODEL=openclaw:main
LLM_PROFILE_OPENCLAW_REVIEWER_MODEL=NONE
LLM_PROFILE_OPENCLAW_SHADOW_MODEL=openclaw:main
LLM_PROFILE_OPENCLAW_SHADOW_REVIEWER_MODEL=NONE
LLM_ALLOW_RUNTIME_CONNECTION_OVERRIDE=false
# OpenClaw isolation (optional)
# OPENCLAW_SESSION_NAMESPACE=fipro1
# OPENCLAW_AGENT_ID=main
# OPENCLAW_SESSION_KEY=

# Backward-compatible single profile fields (optional)
LLM_PROVIDER=openai_compatible
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=30
LLM_PRIMARY_MODEL=gpt-4o-mini
LLM_REVIEWER_MODEL=NONE
LLM_SHADOW_MODEL=gpt-4o-mini
LLM_SHADOW_REVIEWER_MODEL=NONE
BACKTEST_JOBS_STATE_FILE=.run/backtest_jobs_state.json
WORKFLOW_CHECKPOINT_AUTO_MAINTAIN=1
WORKFLOW_CHECKPOINT_COMPACT_THRESHOLD_MB=512
VITE_API_TIMEOUT_MS=45000

TUSHARE_TOKEN=d0e16d5ad3f5de4a75f9f0c96c3a982932e0b8bc2ecec9b0b7f4943f
NEWS_DATA_API_KEY=
TUSHARE_BASE_URL=https://api.tushare.pro
DATASOURCE_TIMEOUT_SECONDS=6

TOOL_RETRY_MAX_ATTEMPTS=3
TOOL_RETRY_BACKOFF_MS=120
TOOL_RETRY_BACKOFF_MAX_MS=1200
TOOL_RATE_LIMIT_MAX_CALLS=400
TOOL_RATE_LIMIT_WINDOW_MS=1000
TOOL_RATE_LIMIT_ACQUIRE_TIMEOUT_MS=250
LLM_RETRY_MAX_ATTEMPTS=2
# LLM_FORCE_FAILURE=timeout
